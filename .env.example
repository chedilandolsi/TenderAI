# TenderAI Environment Variables Template
# Copy this file to .env and configure your production or developer credentials

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tenderai
SPRING_DATASOURCE_USERNAME=tenderai
SPRING_DATASOURCE_PASSWORD=tenderai_secret

# Security & JWT
JWT_SECRET=TenderAIExecutiveSecretKeyMustBeAtLeast256BitsLongForHmacSha256SecurityValidation2026

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
